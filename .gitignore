# 시크릿 - 절대 커밋 금지
.env
.env.*
!.env.example

# SOPS 암호화본은 커밋한다. age 개인키가 없으면 복호화할 수 없으므로
# 공개 레포에 있어도 안전하고, 이렇게 해야 팀원과 공유된다.
# 평문(.env.dev, .env.prod)은 위 규칙에 그대로 걸려서 계속 무시된다.
!.env.*.enc

# 런타임 데이터 (디스코드 유저 ID가 들어간다)
data/
*.db
*.db-wal
*.db-shm

.venv/
venv/
__pycache__/
*.py[cod]
.DS_Store
.idea/
.vscode/

# 로컬 실행 로그
bot_log*.txt
