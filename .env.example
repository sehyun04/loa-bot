# Discord Developer Portal > Applications > Bot
# 개발자마다 각자 테스트용 봇을 만드세요. 같은 토큰 동시 실행은 세션 충돌을 일으킵니다.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# 개발용 테스트 서버 ID. 넣으면 커맨드가 그 서버에 즉시 반영됩니다.
# 비워두면 글로벌 등록이라 반영까지 최대 1시간 걸립니다.
DISCORD_DEV_GUILD_ID=

# https://developer-lostark.game.onstove.com/clients 에서 발급 (bearer 접두사 없이 JWT만)
# 없어도 봇은 뜹니다. 스펙/시세 조회만 비활성화됩니다.
# 한도(분당 100회)가 키 단위이므로 개발자마다 각자 발급하세요.
LOSTARK_API_KEY=
LOA_RATE_LIMIT_PER_MIN=80
LOA_MAX_CONCURRENCY=8
LOA_TIMEOUT_SECONDS=10

# 관리 커맨드를 쓸 수 있는 디스코드 유저 ID. 여러 명이면 콤마로 구분합니다.
OWNER_IDS=

# 크래시 알림 받을 웹훅 (선택)
LOG_WEBHOOK_URL=

BOT_ENV=local
BOT_DATA_DIR=./data

# 포트폴리오 사이트의 니나브 위젯과 나눠 갖는 비밀값.
# 사이트 쪽에도 같은 값을 넣습니다: wrangler secret put NINAV_KEY
# 비워두면 웹 연결을 아예 시도하지 않습니다. 봇만 돌릴 거면 건드리지 마세요.
WEB_API_KEY=

# 사이트 주소. 넣으면 봇이 여기로 붙어 질문을 받아옵니다.
#
# 인바운드 포트를 열지 않으려고 방향을 뒤집었습니다. 오라클 인스턴스는
# 포트가 하나도 안 열려 있고, 열려면 콘솔에서 보안목록을 고쳐야 하는 데다
# 그러고도 Cloudflare 와의 구간이 평문이라 키가 경로에 노출됩니다.
NINAV_SITE_URL=https://sehyun-portfolio.ds187.workers.dev

# 반대로 사이트가 봇을 부르게 하는 방식. 도메인이 생겨 터널을 쓸 때만 켭니다.
# 운영에서는 위의 폴링을 쓰므로 듣는 소켓이 아예 없어야 합니다.
# WEB_API_SERVE=1
# WEB_API_PORT=8080
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel
