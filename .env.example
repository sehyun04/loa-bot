# Discord Developer Portal > Applications > Bot
# 개발자마다 각자 테스트용 봇을 만드세요. 같은 토큰 동시 실행은 세션 충돌을 일으킵니다.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# 개발용 테스트 서버 ID. 넣으면 커맨드가 그 서버에 즉시 반영됩니다.
# 비워두면 글로벌 등록이라 반영까지 최대 1시간 걸립니다.
DISCORD_DEV_GUILD_ID=

# https://developer-lostark.game.onstove.com/clients 에서 발급 (bearer 접두사 없이 JWT만)
# 없어도 봇은 뜹니다. 스펙/시세 조회만 비활성화됩니다.
# 한도(분당 100회)가 키 단위이므로 개발자마다 각자 발급하세요.
LOSTARK_API_KEY=
LOA_RATE_LIMIT_PER_MIN=80
LOA_MAX_CONCURRENCY=8
LOA_TIMEOUT_SECONDS=10

# 관리 커맨드를 쓸 수 있는 디스코드 유저 ID. 여러 명이면 콤마로 구분합니다.
OWNER_IDS=

# 크래시 알림 받을 웹훅 (선택)
LOG_WEBHOOK_URL=

BOT_ENV=local
BOT_DATA_DIR=./data

# 포트폴리오 사이트의 니나브 위젯이 쓰는 HTTP API.
# 비워두면 서버를 아예 띄우지 않습니다. 봇만 돌릴 거면 건드리지 마세요.
# 같은 값을 Worker 쪽에도 넣습니다: wrangler secret put NINAV_KEY
WEB_API_KEY=
WEB_API_PORT=8080

# Cloudflare Tunnel 토큰 (선택). 위 API를 사이트에서 부를 때만 필요합니다.
# 대시보드 Zero Trust > Networks > Tunnels 에서 만든 뒤 붙여넣습니다.
TUNNEL_TOKEN=

# 터널을 쓰는 서버에서만 켭니다.
#
# 배포 워크플로는 `docker compose up -d --build` 만 실행합니다. 여기서 프로필을
# 켜두지 않으면 --profile 이 안 붙어 터널 컨테이너가 영영 안 뜹니다. 반대로
# 코드에 박아두면 토큰이 없는 개발 PC에서 크래시 루프를 돕니다.
# COMPOSE_PROFILES=tunnel
